# Obsidian: share only the repository's Markdown-link policy.
# Keep window layouts, appearance, hotkeys, bookmarks, caches, community
# plugin data and each user's core-plugin choices local.
/.obsidian/*
!/.obsidian/app.json

# Obsidian's local trash must never become repository evidence.
/.trash/

# BIGTREETECH / Phoenix local secrets
# Real host configuration contains Wi-Fi credentials and must never be committed.
system.cfg
*.secrets.cfg
*.secrets
