# Manta M8P V2.0 bridge + EBB36 Gen2 over CAN
[mcu]
canbus_uuid: __MANTA_CAN_UUID__

[mcu EBB]
canbus_uuid: __EBB_CAN_UUID__

[printer]
kinematics: none
max_velocity: 1
max_accel: 1

[temperature_sensor ebb36_driver_ntc]
sensor_type: Generic 3950
sensor_pin: EBB:PA0
pullup_resistor: 2200

[manual_stepper ebb_motor]
step_pin: EBB:PB14
dir_pin: EBB:PA8
enable_pin: !EBB:PB6
microsteps: 16
rotation_distance: 40
velocity: 2
accel: 5

[tmc2209 manual_stepper ebb_motor]
uart_pin: EBB:PB3
run_current: 0.30
sense_resistor: 0.110
interpolate: False
stealthchop_threshold: 0

[lis2dw]
cs_pin: EBB:PB1
spi_bus: spi2_PB2_PB11_PB10
axes_map: x,y,z
